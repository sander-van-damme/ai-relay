{
  "name": "ai-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "install-service": "node scripts/install-service.mjs",
    "opencode:optimize": "node scripts/opencode-optimize.ts",
    "opencode:restore": "node scripts/opencode-restore.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "@huggingface/transformers": "3.8.1",
    "gpt-tokenizer": "4.0.0"
  }
}
