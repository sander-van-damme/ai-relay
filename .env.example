# Relay authentication. At least one relay key is required.
RELAY_API_KEY=replace-with-a-long-random-secret
# RELAY_API_KEY_1=another-key-during-key-rotation
# RELAY_API_KEY_2=...

# Provider credentials.
GEMINI_API_KEY=...
NVIDIA_API_KEY=...

# Optional. Defaults to ./config/models.json.
# AI_RELAY_CONFIG=/etc/ai-relay/models.json
